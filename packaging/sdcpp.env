# Moteur d'images livré avec ChatonLM : sd-server de stable-diffusion.cpp
# (licence MIT, https://github.com/leejet/stable-diffusion.cpp), construit par
# scripts/build-sd-server.sh depuis les sources de ce tag, avec les correctifs
# de packaging/sdcpp/*.patch, en Vulkan (bascule seule sur le processeur sans
# carte graphique), sans OpenMP ni WebP. Sortie : .tools/runtimes/sd-server/
# (sd-server, VERSION, SHA256SUMS, fallback/<chargeur Vulkan>), installée sous
# /usr/lib/chatonlm/sd-server (.deb), /usr/libexec/chatonlm/sd-server
# (AppImage, lien depuis /usr/lib/chatonlm) ou <installation>\sd-server
# (Windows). Licences des parties compilées : packaging/sdcpp/licenses/.
SDCPP_VERSION=master-964-1d0a58a
SDCPP_REPO=https://github.com/leejet/stable-diffusion.cpp
SDCPP_COMMIT=1d0a58a35050d285b1d6fb1bc68a92924d35825e
# Sous-module ggml à ce commit (seul sous-module construit).
SDCPP_GGML_COMMIT=d25b121ce1d6ae0c7e62ad080460d9fc1e46dd93

# Chargeur Vulkan de secours (livré dans fallback/) : Vulkan-Loader de Khronos
# (Apache-2.0), construit avec Vulkan-Headers au même tag.
VULKAN_LOADER_TAG=vulkan-sdk-1.4.321.0
VULKAN_LOADER_REPO=https://github.com/KhronosGroup/Vulkan-Loader
VULKAN_LOADER_COMMIT=da8d2caad9341ca8c5a7c3deba217d7da50a7c24
VULKAN_HEADERS_REPO=https://github.com/KhronosGroup/Vulkan-Headers
VULKAN_HEADERS_COMMIT=2cd90f9d20df57eac214c148f3aed885372ddcfe

# Outils Vulkan de la construction de sd-server (en-têtes, glslc) :
# SDK de LunarG, versions éprouvées par la CI d'Ollama. Linux (ubuntu-22.04) :
# dépôt apt de LunarG ; Windows : installateur vérifié par son empreinte
# (https://sdk.lunarg.com/sdk/sha/<version>/windows/<fichier>.txt).
VULKAN_SDK_LINUX_APT=1.4.313
VULKAN_SDK_WINDOWS_VERSION=1.4.321.1
VULKAN_SDK_WINDOWS_URL=https://sdk.lunarg.com/sdk/download/1.4.321.1/windows/vulkansdk-windows-X64-1.4.321.1.exe
VULKAN_SDK_WINDOWS_SHA256=baaa4f7ca11ed3d82aa1c102b21208915485bbaa473068c763daa425cca468bd
