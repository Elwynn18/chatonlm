# VSCodium (build libre de VS Code, MIT) pour l'essai de l'extension dans un
# vrai éditeur (e2e/vscode-extension.test.mjs). Jamais livré : seulement
# téléchargé dans .tools/vscodium/<version> par scripts/fetch-vscodium.sh,
# empreinte vérifiée (fichier .sha256 de la release, relevé ici). Version
# choisie plus de deux semaines après sa sortie, au-dessus du minimum de
# l'extension (engines.vscode ^1.105.0).
VSCODIUM_VERSION=1.140.06880
