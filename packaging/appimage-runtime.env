# Runtime de l'AppImage (en-tête exécutable qui monte l'image squashfs),
# épinglé au lieu de la version « continuous » que télécharge appimagetool :
# scripts/package.sh le télécharge, vérifie son empreinte et le donne à
# linuxdeploy-plugin-appimage (LDAI_RUNTIME_FILE). Il embarque libfuse en
# statique (LGPL-2.1) : scripts/appimage-libs.sh --sources joint son code
# source et celui du runtime à l'archive publiée à côté de l'AppImage, et
# scripts/package-notices.mjs le décrit dans la notice de l'AppImage.
# Versions lues dans scripts/common/install-dependencies.sh et
# scripts/chroot/chroot_build.sh du dépôt au tag ci-dessous.
TYPE2_RUNTIME_TAG=20251108
TYPE2_RUNTIME_COMMIT=dd6cebedcbddde9c82f89b011e8e1d40b6e43868
TYPE2_RUNTIME_URL=https://github.com/AppImage/type2-runtime/releases/download/20251108/runtime-x86_64
TYPE2_RUNTIME_SHA256=2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d
TYPE2_RUNTIME_SOURCE_URL=https://github.com/AppImage/type2-runtime/archive/dd6cebedcbddde9c82f89b011e8e1d40b6e43868.tar.gz
LIBFUSE_VERSION=3.15.0
LIBFUSE_URL=https://github.com/libfuse/libfuse/releases/download/fuse-3.15.0/fuse-3.15.0.tar.xz
LIBFUSE_SHA256=70589cfd5e1cff7ccd6ac91c86c01be340b227285c5e200baa284e401eea2ca0
SQUASHFUSE_VERSION=0.5.2
SQUASHFUSE_URL=https://github.com/vasi/squashfuse/archive/0.5.2.tar.gz
SQUASHFUSE_SHA256=db0238c5981dabbd80ee09ae15387f390091668ca060a7bc38047912491443d3
ALPINE_RELEASE=3.21.0
