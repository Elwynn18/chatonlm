# Pack CUDA de ChatonLM (facultatif, téléchargé par l'app à la demande depuis
# Settings › Engine) : accélération des cartes NVIDIA par CUDA 13, à côté du
# llama-server livré (packaging/llama.env, MÊME commit : ggml-base est celui
# du serveur, l'interface des moteurs n'est stable qu'à commit égal).
#
# Deux parties, téléchargées séparément par l'app :
# - le pack de NOTRE Release (MIT) : chatonlm-cuda-<LLAMA_BUILD>-linux-x64.tar.gz
#   / -windows-x64.zip = libggml-cuda.so / ggml-cuda.dll construit par
#   « scripts/build-llama-server.sh --cuda » (cible ggml-cuda seule,
#   architectures par défaut de ggml pour CUDA 13 : 7.5 Turing et plus),
#   VERSION, SHA256SUMS et licences (llama.cpp MIT, CCCL Apache-2.0 avec
#   exception LLVM) ; signé (minisign) par la clé des mises à jour ;
# - les bibliothèques de NVIDIA (cudart, cublas, cublasLt), JAMAIS rehébergées :
#   prises par l'app sur le serveur de NVIDIA (archives « redist » ci-dessous,
#   taille et SHA-256 vérifiées), sous la licence du CUDA Toolkit (EULA,
#   montrée avant le téléchargement et rangée à côté). Seules les trois
#   bibliothèques sont gardées de chaque archive.
#
# Construction : Linux dans le conteneur CUDA_CONTAINER (Ubuntu 22.04 : glibc
# 2.35, comme les paquets), Windows avec le toolkit monté depuis les mêmes
# archives redist et Visual Studio 2022 (MSVC).

# Toolkit et index des archives de NVIDIA (épinglé par son empreinte).
CUDA_VERSION=13.4.1
CUDA_MAJOR=13
CUDA_CONTAINER=nvidia/cuda:13.4.1-devel-ubuntu22.04
CUDA_REDIST_URL=https://developer.download.nvidia.com/compute/cuda/redist/
CUDA_INDEX=redistrib_13.4.1.json
CUDA_INDEX_SHA256=e24677584a7161a69f370271fc638b252a0e77e48bdf5fccf1862bae028c08d5
# CCCL récupéré par ggml (GGML_CUDA_CCCL_VERSION), comme la CI de llama.cpp
# pour un toolkit 13.4 (celui du toolkit suffit à partir de 13.5).
CUDA_CCCL_VERSION=v3.4.3

# Pilote minimal : 580 pour toute la famille 13.x (compatibilité de version
# mineure) ; capacité de calcul minimale de CUDA 13 (Turing). Les cartes plus
# anciennes (GTX 10xx et avant) restent sur Vulkan.
CUDA_DRIVER_MIN=580
CUDA_COMPUTE_MIN=7.5

# Archives de NVIDIA téléchargées par l'app (chemin sous CUDA_REDIST_URL,
# taille en octets, SHA-256), relevées dans l'index ci-dessus.
CUDA_CUDART_VERSION=13.4.49
CUDA_CUDART_LINUX_PATH=cuda_cudart/linux-x86_64/cuda_cudart-linux-x86_64-13.4.49-archive.tar.xz
CUDA_CUDART_LINUX_SIZE=1702296
CUDA_CUDART_LINUX_SHA256=ec3df9f91560db23a064c6b395d4fde17b2893f5bf954c6bd193dd03a44de522
CUDA_CUDART_WINDOWS_PATH=cuda_cudart/windows-x86_64/cuda_cudart-windows-x86_64-13.4.49-archive.zip
CUDA_CUDART_WINDOWS_SIZE=2736140
CUDA_CUDART_WINDOWS_SHA256=e6663f3d3e8949eedc2d5ab92c7c5b9fa3f2a222086d91c42bfc5a38bf2b0225
CUDA_CUBLAS_VERSION=13.7.0.27
CUDA_CUBLAS_LINUX_PATH=libcublas/linux-x86_64/libcublas-linux-x86_64-13.7.0.27-archive.tar.xz
CUDA_CUBLAS_LINUX_SIZE=880573744
CUDA_CUBLAS_LINUX_SHA256=cc38b57206f5fbfe1f7f510bffde3059c525c0119ff3af8e40a6f90f147c01c3
CUDA_CUBLAS_WINDOWS_PATH=libcublas/windows-x86_64/libcublas-windows-x86_64-13.7.0.27-archive.zip
CUDA_CUBLAS_WINDOWS_SIZE=423620712
CUDA_CUBLAS_WINDOWS_SHA256=fff93984ee8a85dd8568e4b9000f9e3ef7153f0f73b176756bcbad3c6622d1f0

# Licence montrée avant le téléchargement (texte rangé à côté des
# bibliothèques : LICENSE de l'archive cuda_cudart).
CUDA_EULA_URL=https://docs.nvidia.com/cuda/eula/index.html
