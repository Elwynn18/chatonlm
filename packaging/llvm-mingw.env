# llvm-mingw (clang, lld et la bibliothèque C de mingw-w64 pour Windows) :
# chaîne de compilation croisée du contrôle Windows fait depuis Linux
# (scripts/check-windows.sh, cible Rust x86_64-pc-windows-gnullvm). Elle ne
# construit aucun paquet : les installateurs Windows sortent de la CI (MSVC).
# scripts/fetch-llvm-mingw.sh la télécharge, vérifie son empreinte et l'extrait
# dans .tools/llvm-mingw/<version>.
LLVM_MINGW_VERSION=20261006
LLVM_MINGW_URL=https://github.com/mstorsjo/llvm-mingw/releases/download/20261006/llvm-mingw-20261006-ucrt-ubuntu-22.04-x86_64.tar.xz
LLVM_MINGW_SHA256=5f9c6ed95b2d4bdb2869a488c5fd5857fbdabcf288a0aa3eb1da43f6a08d8ab4
