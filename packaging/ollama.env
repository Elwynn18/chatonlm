# Ollama intégré aux paquets (mode hybride, étape 18b) : archive officielle
# d'Ollama pour Linux (glibc), dont on ne garde que le serveur, le runner
# llama.cpp et les bibliothèques CPU et Vulkan (sans cuda_*, rocm*, mlx* :
# ~96 Mo au lieu de 2,1 Go). scripts/fetch-ollama.sh la télécharge (ou reprend
# la copie vérifiée de .tools/ollama-dist/v<version>/), vérifie son empreinte
# (champ « digest » de l'API des releases GitHub, aussi dans le sha256sum.txt
# de la release) et l'extrait dans .tools/runtimes/ollama ; les paquets
# l'installent dans /usr/lib/chatonlm/ollama (dossier des ressources de Tauri :
# resource_dir()/ollama/bin/ollama).
OLLAMA_VERSION=0.40.0
OLLAMA_URL=https://github.com/ollama/ollama/releases/download/v0.40.0/ollama-linux-amd64.tar.zst
OLLAMA_SHA256=c94aa4156b3d13e64ebc2efe5ea53f015384c882be776e6695cfb37fb180d5ad
# lib/ollama/libgomp.so.1 (runtime OpenMP, GPL-3.0 avec la GCC Runtime
# Library Exception 3.1) : version de GCC, lue dans ses notes de build
# (« running gcc 8.5.0 »), et construction exacte, celle du paquet libgomp
# d'AlmaLinux 8 dont il vient (lien de débogage
# « libgomp.so.1.0.0-<construction>.x86_64.debug ») ; sa source
# correspondante est le paquet source gcc de cette construction. Citées par la
# notice (licenses/ollama/README.txt, copyright) ; fetch-ollama.sh vérifie
# qu'elles n'ont pas changé.
OLLAMA_LIBGOMP_GCC=8.5.0
OLLAMA_LIBGOMP_BUILD=8.5.0-28.el8_10.alma.1
OLLAMA_LIBGOMP_SOURCE=https://vault.almalinux.org/8.10/BaseOS/Source/Packages/gcc-8.5.0-28.el8_10.alma.1.src.rpm
# Windows (x64) : archive officielle de la même version, dont on ne garde
# que ollama.exe, lib/ollama (runner llama.cpp, bibliothèques CPU) et
# lib/ollama/vulkan, sans cuda_v12 ni cuda_v13 (110 Mio au lieu de 1,85 Gio ;
# ROCm et MLX sont des archives à part sous Windows). Empreinte : champ
# « digest » de l'API des releases GitHub. Pas de libgomp : son OpenMP est
# libomp.dll (LLVM).
OLLAMA_WINDOWS_URL=https://github.com/ollama/ollama/releases/download/v0.40.0/ollama-windows-amd64.zip
OLLAMA_WINDOWS_SHA256=3623e256762ca89bd6fa99b0cc4106401919ce9df926411673e632e3ea287bb5
