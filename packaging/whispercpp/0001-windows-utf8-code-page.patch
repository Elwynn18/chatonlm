 install(TARGETS ${TARGET} RUNTIME)
+
+# ChatonLM: UTF-8 as the process code page on Windows, so that model paths with
+# non-ASCII characters (user folders) reach whisper.cpp in UTF-8, the encoding
+# it converts to UTF-16 before opening the file.
+if (WIN32)
+    target_sources(${TARGET} PRIVATE utf8.manifest)
+endif()
