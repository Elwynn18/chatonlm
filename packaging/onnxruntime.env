# ONNX Runtime (moteur du modèle de dictée Parakeet), chargé à l'exécution
# (fonctionnalité load-dynamic d'ort) : build officiel de Microsoft (glibc ≥ 2.27,
# GLIBCXX ≥ 3.4.21), et non les binaires statiques de pyke qu'ort-sys télécharge
# par défaut (compilés pour glibc ≥ 2.38 : impossible à lier sous Ubuntu 22.04).
# scripts/fetch-onnxruntime.sh le télécharge, vérifie son empreinte (champ
# « digest » de l'API des releases GitHub) et l'extrait dans
# .tools/runtimes/onnxruntime ; les paquets l'installent dans
# /usr/lib/chatonlm/libonnxruntime.so.1 (dossier des ressources de Tauri).
ORT_VERSION=1.28.3
ORT_URL=https://github.com/microsoft/onnxruntime/releases/download/v1.28.3/onnxruntime-linux-x64-1.28.3.tgz
ORT_SHA256=db14e4863bd37893fc59729d986ab2a0d043d10b7d44da1913c4982b7e3d009c
# Windows x64 : archive officielle (processeur seul, sans DirectML), dont
# seule lib/onnxruntime.dll est livrée, à côté de l'exécutable. Elle exige le
# runtime MSVC (msvcp140*.dll, vcruntime140*.dll), livré avec elle.
ORT_WIN_URL=https://github.com/microsoft/onnxruntime/releases/download/v1.28.3/onnxruntime-win-x64-1.28.3.zip
ORT_WIN_SHA256=1d6fab48e85f948436af7c8c971d2c145cf224e2c444755dec894f8b0de11a83
