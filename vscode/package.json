{
  "name": "chatonlm",
  "displayName": "ChatonLM",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "chatonlm",
  "private": true,
  "license": "MIT",
  "author": "Elwynn18 and ChatonLM contributors",
  "homepage": "https://chatonlm.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Elwynn18/chatonlm"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "chatonlm",
          "title": "ChatonLM",
          "icon": "media/chatonlm.svg"
        }
      ]
    },
    "views": {
      "chatonlm": [
        {
          "type": "webview",
          "id": "chatonlm.chat",
          "name": "%view.chat%"
        }
      ]
    },
    "configuration": {
      "title": "ChatonLM",
      "properties": {
        "chatonlm.completion.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "%config.completion.enabled%"
        },
        "chatonlm.completion.model": {
          "type": "string",
          "default": "auto",
          "scope": "application",
          "markdownDescription": "%config.completion.model%"
        },
        "chatonlm.completion.multiline": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%config.completion.multiline%"
        },
        "chatonlm.completion.ignoreOthers": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "%config.completion.ignoreOthers%"
        },
        "chatonlm.notify.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "%config.notify.enabled%"
        },
        "chatonlm.notify.minDurationSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "scope": "application",
          "description": "%config.notify.minDurationSeconds%"
        },
        "chatonlm.notify.includeFolderName": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "%config.notify.includeFolderName%"
        }
      }
    },
    "commands": [
      {
        "command": "chatonlm.pair",
        "title": "%command.pair%",
        "category": "ChatonLM"
      },
      {
        "command": "chatonlm.unpair",
        "title": "%command.unpair%",
        "category": "ChatonLM"
      },
      {
        "command": "chatonlm.openApp",
        "title": "%command.openApp%",
        "category": "ChatonLM"
      },
      {
        "command": "chatonlm.newChat",
        "title": "%command.newChat%",
        "category": "ChatonLM",
        "icon": "$(add)"
      },
      {
        "command": "chatonlm.newEphemeralChat",
        "title": "%command.newEphemeralChat%",
        "category": "ChatonLM"
      },
      {
        "command": "chatonlm.explain",
        "title": "%command.explain%",
        "category": "ChatonLM"
      },
      {
        "command": "chatonlm.fix",
        "title": "%command.fix%",
        "category": "ChatonLM"
      },
      {
        "command": "chatonlm.tests",
        "title": "%command.tests%",
        "category": "ChatonLM"
      },
      {
        "command": "chatonlm.commitMessage",
        "title": "%command.commitMessage%",
        "category": "ChatonLM",
        "icon": "$(sparkle)"
      },
      {
        "command": "chatonlm.tour",
        "title": "%command.tour%",
        "category": "ChatonLM",
        "icon": "$(unmute)"
      },
      {
        "command": "chatonlm.tourChanges",
        "title": "%command.tourChanges%",
        "category": "ChatonLM",
        "icon": "$(unmute)"
      },
      {
        "command": "chatonlm.tourTogglePause",
        "title": "%command.tourTogglePause%",
        "category": "ChatonLM"
      },
      {
        "command": "chatonlm.tourPrevious",
        "title": "%command.tourPrevious%",
        "category": "ChatonLM"
      },
      {
        "command": "chatonlm.tourNext",
        "title": "%command.tourNext%",
        "category": "ChatonLM"
      },
      {
        "command": "chatonlm.tourStop",
        "title": "%command.tourStop%",
        "category": "ChatonLM"
      },
      {
        "command": "chatonlm.talkItThrough",
        "title": "%command.talkItThrough%",
        "category": "ChatonLM"
      },
      {
        "command": "chatonlm.stopTalking",
        "title": "%command.stopTalking%",
        "category": "ChatonLM"
      },
      {
        "command": "chatonlm.completionMenu",
        "title": "%command.completionMenu%",
        "category": "ChatonLM"
      },
      {
        "command": "chatonlm.completionToggle",
        "title": "%command.completionToggle%",
        "category": "ChatonLM"
      },
      {
        "command": "chatonlm.notifyWhenDone",
        "title": "%command.notifyWhenDone%",
        "category": "ChatonLM",
        "icon": "$(bell)"
      },
      {
        "command": "chatonlm.notifyCancel",
        "title": "%command.notifyCancel%",
        "category": "ChatonLM"
      },
      {
        "command": "chatonlm.studyProject",
        "title": "%command.studyProject%",
        "category": "ChatonLM"
      },
      {
        "command": "chatonlm.studyLanguage",
        "title": "%command.studyLanguage%",
        "category": "ChatonLM"
      },
      {
        "command": "chatonlm.generateImage",
        "title": "%command.generateImage%",
        "category": "ChatonLM"
      },
      {
        "command": "chatonlm.saveImage",
        "title": "%command.saveImage%",
        "category": "ChatonLM"
      },
      {
        "command": "chatonlm.proofreadComments",
        "title": "%command.proofreadComments%",
        "category": "ChatonLM"
      },
      {
        "command": "chatonlm.proofreadDocument",
        "title": "%command.proofreadDocument%",
        "category": "ChatonLM"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "chatonlm.explain",
          "when": "editorTextFocus",
          "group": "chatonlm@1"
        },
        {
          "command": "chatonlm.tests",
          "when": "editorTextFocus",
          "group": "chatonlm@2"
        },
        {
          "command": "chatonlm.tour",
          "when": "editorTextFocus",
          "group": "chatonlm@3"
        },
        {
          "command": "chatonlm.proofreadComments",
          "when": "editorTextFocus && editorLangId != markdown && editorLangId != plaintext",
          "group": "chatonlm@4"
        },
        {
          "command": "chatonlm.proofreadDocument",
          "when": "editorTextFocus && editorLangId =~ /^(markdown|plaintext)$/",
          "group": "chatonlm@4"
        }
      ],
      "scm/title": [
        {
          "command": "chatonlm.commitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "chatonlm.explain",
          "when": "editorIsOpen"
        },
        {
          "command": "chatonlm.fix",
          "when": "editorIsOpen"
        },
        {
          "command": "chatonlm.tests",
          "when": "editorIsOpen"
        },
        {
          "command": "chatonlm.tour",
          "when": "editorIsOpen"
        },
        {
          "command": "chatonlm.tourChanges",
          "when": "editorIsOpen"
        },
        {
          "command": "chatonlm.tourTogglePause",
          "when": "chatonlm.touring"
        },
        {
          "command": "chatonlm.tourPrevious",
          "when": "chatonlm.touring"
        },
        {
          "command": "chatonlm.tourNext",
          "when": "chatonlm.touring"
        },
        {
          "command": "chatonlm.tourStop",
          "when": "chatonlm.touring"
        },
        {
          "command": "chatonlm.stopTalking",
          "when": "chatonlm.talking"
        },
        {
          "command": "chatonlm.notifyCancel",
          "when": "false"
        },
        {
          "command": "chatonlm.generateImage",
          "when": "editorIsOpen"
        },
        {
          "command": "chatonlm.studyLanguage",
          "when": "editorIsOpen"
        },
        {
          "command": "chatonlm.proofreadComments",
          "when": "editorIsOpen"
        },
        {
          "command": "chatonlm.proofreadDocument",
          "when": "editorLangId =~ /^(markdown|plaintext)$/"
        },
        {
          "command": "chatonlm.saveImage",
          "when": "false"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "chatonlm.tourChanges",
          "when": "scmProvider == git",
          "group": "chatonlm@1"
        }
      ],
      "terminal/context": [
        {
          "command": "chatonlm.notifyWhenDone",
          "group": "chatonlm@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "chatonlm.tourTogglePause",
        "key": "shift+alt+space",
        "when": "chatonlm.touring"
      },
      {
        "command": "chatonlm.tourPrevious",
        "key": "shift+alt+,",
        "when": "chatonlm.touring"
      },
      {
        "command": "chatonlm.tourNext",
        "key": "shift+alt+.",
        "when": "chatonlm.touring"
      },
      {
        "command": "chatonlm.tourStop",
        "key": "shift+alt+escape",
        "when": "chatonlm.touring"
      }
    ]
  },
  "devDependencies": {
    "@types/vscode": "1.105.0"
  }
}
