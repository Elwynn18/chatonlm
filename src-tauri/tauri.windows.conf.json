{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatonLM",
  "build": {
    "windows": {
      "staticVCRuntime": false
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ChatonLM",
        "width": 1360,
        "height": 960,
        "minWidth": 900,
        "minHeight": 660,
        "visible": false,
        "create": false,
        "center": true,
        "generalAutofillEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: chatonlm: http://chatonlm.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "bundleVCRuntime": true,
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "French", "Spanish"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "../packaging/windows/hooks.nsh"
      }
    }
  }
}
